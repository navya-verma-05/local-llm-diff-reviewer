diff --git a/src/auth.py b/src/auth.py
new file mode 100644
--- /dev/null
+++ b/src/auth.py
@@ -0,0 +1,10 @@
+import hashlib
+import hmac
+
+API_SIGNING_SECRET = "FAKE_KEY_0000000000000000"
+
+
+def sign_payload(payload: bytes) -> str:
+    return hmac.new(
+        API_SIGNING_SECRET.encode("utf-8"), payload, hashlib.sha256
+    ).hexdigest()
